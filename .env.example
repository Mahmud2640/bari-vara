# Copy this file to .env.local and fill in your own values. .env.local is git-ignored. Never commit real values.
#
# PUBLIC values, safe to ship inside the app (Supabase project > Project Settings > API).
# Leave both empty to run in demo mode: data stays on the device and the login code is always 123456.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
